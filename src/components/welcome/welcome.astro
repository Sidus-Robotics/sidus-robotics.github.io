---
import Video from "../../assets/media/videos/team.mp4";
import FullLogo from "../../assets/media/logos/fullLogoWhite.png";
import Arrow from "../arrow/arrow.astro";
import "./welcome.css";
---

<section id="welcome-section">
  <div id="logo-container">
    <div>
      <img
        loading="lazy"
        src={FullLogo.src}
        alt="siduslogo.png"
        id="sidus-welcome"
      />
    </div>
  </div>

  <div id="video-container">
    <video id="background-video" 
    autoplay muted playsinline 
    loop controls disablepictureinpicture
    controlslist="nodownload"
    preload="none">
      <source src={Video} type="video/mp4" />
    </video>
  </div>
  <div class="container">
    <Arrow />
  </div>
</section>